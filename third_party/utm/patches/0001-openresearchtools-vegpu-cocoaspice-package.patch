+++ b/OpenResearchTools/CocoaSpice/Sources/CocoaSpice/ExternalHeaders/gstreamer-1.0/gst/gstparamspecs.h
@@ -0,0 +1,190 @@
+/* GStreamer - GParamSpecs for some of our types
+ * Copyright (C) 2007 Tim-Philipp Müller  <tim centricular net>
