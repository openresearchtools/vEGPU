+  gpointer                 user_data;
+  GDestroyNotify           destroy_notify;
+
+  /*< private >*/
+  GstClockTime             last_time;
+  GstClockTimeDiff         time_offset;
+
+  gpointer _gst_reserved[GST_PADDING];
+};
+
+struct _GstAudioClockClass {
+  GstSystemClockClass parent_class;
+
+  /*< private >*/
+  gpointer _gst_reserved[GST_PADDING];
+};
