+
+#if TARGET_OS_IPHONE
+- (instancetype)initWithImage:(UIImage *)image {
+    if (self = [super init]) {
+        _image = image;
+    }
+    return self;
+}
+
+- (instancetype)initWithContentsOfURL:(NSURL *)url {
+    UIImage *image = [[UIImage alloc] initWithContentsOfFile:url.path];
+    if (image) {
+        return [self initWithImage:image];
+    } else {
+        return nil;
+    }
