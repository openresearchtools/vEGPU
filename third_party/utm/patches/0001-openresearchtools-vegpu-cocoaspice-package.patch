+                                        const gchar * fragment) G_GNUC_MALLOC;
+GST_API
+GstUri * gst_uri_new_with_base         (GstUri * base,
+                                        const gchar * scheme,
+                                        const gchar * userinfo,
+                                        const gchar * host,
