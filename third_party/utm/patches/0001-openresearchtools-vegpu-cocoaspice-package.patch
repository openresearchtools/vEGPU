diff --git a/OpenResearchTools/CocoaSpice/Sources/CocoaSpice/ExternalHeaders/gstreamer-1.0/gst/gstallocator.h b/OpenResearchTools/CocoaSpice/Sources/CocoaSpice/ExternalHeaders/gstreamer-1.0/gst/gstallocator.h
