diff --git a/OpenResearchTools/CocoaSpice/Sources/CocoaSpice/ExternalHeaders/gstreamer-1.0/gst/gstversion.h b/OpenResearchTools/CocoaSpice/Sources/CocoaSpice/ExternalHeaders/gstreamer-1.0/gst/gstversion.h
