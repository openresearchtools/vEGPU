+                                                     GString *str);
+
+/* handling the body */
+
+GST_RTSP_API
+GstRTSPResult      gst_rtsp_message_set_body        (GstRTSPMessage *msg,
+                                                     const guint8 *data,
+                                                     guint size);
+
