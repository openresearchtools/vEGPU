+typedef gboolean (*GstStructureMapFunc)     (GQuark   field_id,
+                                             GValue * value,
+                                             gpointer user_data);
+
+/**
+ * GstStructureFilterMapFunc:
+ * @field_id: the #GQuark of the field name
