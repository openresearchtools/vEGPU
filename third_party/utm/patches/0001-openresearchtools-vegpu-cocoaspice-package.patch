+GST_RTP_API
+GType gst_rtp_base_depayload_get_type (void);
+
+GST_RTP_API
+GstFlowReturn   gst_rtp_base_depayload_push       (GstRTPBaseDepayload *filter, GstBuffer *out_buf);
+
+GST_RTP_API
