+
+GST_API
+GList * gst_uri_get_path_segments      (const GstUri * uri);
+
+GST_API
+gboolean gst_uri_set_path_segments     (GstUri * uri, GList * path_segments);
+
+GST_API
+gboolean gst_uri_append_path           (GstUri * uri,
+                                        const gchar * relative_path);
+GST_API
