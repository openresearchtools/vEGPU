+                                                     GstRTSPHeaderField field,
+                                                     gchar **value,
+                                                     gint indx);
+
+GST_RTSP_API
+GstRTSPResult      gst_rtsp_message_add_header_by_name    (GstRTSPMessage * msg,
+                                                           const gchar    * header,
